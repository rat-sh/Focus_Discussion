# Environment variables for Focus Lock
# Copy this file to .env.local and fill in values.

# Enable demo controls in production builds (default: false)
# VITE_ENABLE_DEMO=true

# Use mock repositories (default true). Set false to use Supabase.
VITE_USE_MOCK=true

# Required when VITE_USE_MOCK=false (anon key only — never the service role).
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only values belong in server/.env; do not prefix them with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
