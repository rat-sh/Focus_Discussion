# Server settings; local migration credentials belong only in ignored server/.env.
NODE_ENV=production
PORT=8787
TRUST_PROXY=true
COOKIE_SECURE=true

# Secrets: server-only database credentials.
DATABASE_URL=YOUR_VALUE_HERE
DATABASE_URL_ADMIN=YOUR_VALUE_HERE
# Secret: connection string for the Render Key Value instance.
VALKEY_URL=YOUR_VALUE_HERE
# Public Supabase project configuration; use the anon/publishable key only.
SUPABASE_URL=YOUR_VALUE_HERE
SUPABASE_ANON_KEY=YOUR_VALUE_HERE
# Secrets: LiveKit server credentials.
LIVEKIT_URL=wss://YOUR_VALUE_HERE
LIVEKIT_API_KEY=YOUR_VALUE_HERE
LIVEKIT_API_SECRET=YOUR_VALUE_HERE
# Optional secret for server-side YouTube search.
YOUTUBE_API_KEY=YOUR_VALUE_HERE
# Public app origin(s), comma-separated; no localhost in production.
CORS_ORIGINS=https://YOUR_VALUE_HERE

# Optional server tuning.
BODY_LIMIT_BYTES=100000
REFRESH_TOKEN_TTL_SEC=2592000

# Build-time only; VITE_* values are included in the public browser bundle.
VITE_USE_MOCK=false
VITE_SUPABASE_URL=https://YOUR_VALUE_HERE
VITE_SUPABASE_ANON_KEY=YOUR_VALUE_HERE
