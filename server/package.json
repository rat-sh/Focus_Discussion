{
  "name": "studyroom-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x eslint src/ tests/ scripts/",
    "test": "bun test --parallel=1 tests/",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@studyroom/contract": "workspace:*",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/bun": "^1.2.0",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
