# Copy to server/.env locally. Keep server credentials out of VITE_* variables.
NODE_ENV=development
PORT=8787
DATABASE_URL=YOUR_VALUE_HERE
DATABASE_URL_ADMIN=YOUR_VALUE_HERE
VALKEY_URL=YOUR_VALUE_HERE
CORS_ORIGINS=https://YOUR_VALUE_HERE
TRUST_PROXY=false
COOKIE_SECURE=false
BODY_LIMIT_BYTES=100000
REFRESH_TOKEN_TTL_SEC=2592000

# Supabase anon key only; these server values are not browser build variables.
SUPABASE_URL=YOUR_VALUE_HERE
SUPABASE_ANON_KEY=YOUR_VALUE_HERE

# Optional server credentials.
LIVEKIT_URL=wss://YOUR_VALUE_HERE
LIVEKIT_API_KEY=YOUR_VALUE_HERE
LIVEKIT_API_SECRET=YOUR_VALUE_HERE
YOUTUBE_API_KEY=YOUR_VALUE_HERE
