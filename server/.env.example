NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_ADMIN=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
VALKEY_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
BODY_LIMIT_BYTES=100000
REFRESH_TOKEN_TTL_SEC=2592000

# Supabase project used by the live web client and live-room API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# LiveKit server credentials; never expose these to the browser.
LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional YouTube Data API key; enables server-proxied search in live rooms.
YOUTUBE_API_KEY=
