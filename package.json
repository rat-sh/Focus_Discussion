{
  "name": "focus-lock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["server", "contract"],
  "scripts": {
    "dev": "vite",
    "dev:api": "bun --env-file=server/.env --watch server/src/index.ts",
    "start:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-real.ps1",
    "prebuild": "bun run scripts/copy-mediapipe-wasm.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "check:all": "bun run check && bun run --cwd server check",
    "db:migrate": "bun --env-file=server/.env server/scripts/migrate.ts",
    "smoke": "python3 scripts/smoke.py http://localhost:4173",
    "audit": "python3 scripts/ui-audit.py http://localhost:4173 --shots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@studyroom/contract": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "livekit-client": "^2.22.4",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
